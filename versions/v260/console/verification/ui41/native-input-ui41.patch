+fn pad_neutral(pad: &gilrs::Gamepad<'_>, deadzone: f64) -> bool {
+    let axes = [Axis::LeftStickX, Axis::LeftStickY, Axis::RightStickX, Axis::RightStickY]
+        .map(|axis| pad.value(axis));
+    let triggers = [Button::LeftTrigger2, Button::RightTrigger2]
+        .map(|button| pad.button_data(button).map(|value| value.value()).unwrap_or(0.0));
+    let buttons = CONTROL_BUTTONS.into_iter().any(|button|
+        !matches!(button, Button::Start | Button::Select) && pad.is_pressed(button));
+    neutral_values(axes, triggers, buttons, deadzone)
+}
+
+fn neutral_values(axes: [f32; 4], triggers: [f32; 2], ordinary_button: bool, deadzone: f64) -> bool {
+    !ordinary_button && axes.into_iter().all(|v| v.is_finite() && (v == 0.0 || (v as f64).abs() < deadzone))
+        && triggers.into_iter().all(|v| v.is_finite() && v.abs() < 0.1)
+}
+
+fn input_lease_readiness(input: &PadInput, neutral: bool, safety_held: bool) -> Result<(), &'static str> {
+    if input.pose_reset_pending { Err("pose-active") }
+    else if input.mode != Mode::Drive { Err("not-drive") }
+    else if matches!(input.imu_head, PadImuHead::Following { .. }) { Err("imu-head") }
+    else if !neutral || safety_held { Err("not-neutral") }
+    else { Ok(()) }
+}
+
+fn finish_input_handoff(
+    stream: &mut UnixStream, continuous: &mut Continuous, at: Instant,
+    was_active: bool, active: bool,
+) -> std::io::Result<bool> {
+    if !was_active || active { return Ok(false); }
+    // Only leases granted from ordinary Drive can reach this transition. Clear
+    // this AI interval's body offset and speed, never a pre-existing pad pose.
+    let frame = [proto::Call::RobotMove(proto::MoveParams::default()),
+        proto::Call::RobotPose(proto::PoseParams { active: false, ..Default::default() })];
+    continuous.at = None;
+    continuous.send(stream, &frame, at)?;
+    continuous.at = None;
+    Ok(true)
+}
