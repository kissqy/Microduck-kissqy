+    /* Repeat and duplicate presses must not become additional record clicks.
+     * Keep both source levels: losing Consumer Control cannot release a MODE
+     * still held on the main node, and alias releases cannot cut each other off. */
+    if (value != 0 && value != 1)
+        return true;
+    if (source == 0) {
+        mode->primary = value != 0;
+    } else {
+        unsigned mask = code == KEY_HOMEPAGE ? 1u : 2u;
+        if (value) mode->consumer |= mask;
+        else mode->consumer &= ~mask;
+    }
+    return emit_mode(ufd, mode);
